# Server
NODE_ENV=development
PORT=4000

# Database aplikasi (PM Monitoring)
DATABASE_URL=postgresql://pm_app_user:xxxxx@localhost:5432/pm_monitoring

# Database ConMas (READ-ONLY - dipakai mulai Fase 3, disiapkan dari sekarang)
CONMAS_DB_HOST=xxx
CONMAS_DB_PORT=5432
CONMAS_DB_NAME=xxx
CONMAS_DB_USER=pm_readonly_sync
CONMAS_DB_PASSWORD=xxxxx

# Auth
JWT_SECRET=xxxxx
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# Seed Admin pertama (dipakai oleh migration seed-admin-user, HAPUS/ganti setelah migration jalan sekali)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=ChangeMe123!
ADMIN_DEFAULT_FULLNAME=Administrator
