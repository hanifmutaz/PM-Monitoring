+          className
+        )}
+        {...props}
+      />
+    </TooltipPrimitive.Portal>
+  );
+}
+
+export { TooltipProvider, Tooltip, TooltipTrigger, TooltipContent };
diff --git a/frontend/src/contexts/ConfirmDialogContext.jsx b/frontend/src/contexts/ConfirmDialogContext.jsx
